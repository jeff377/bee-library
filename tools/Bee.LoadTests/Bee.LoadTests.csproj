<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Bee.LoadTests</RootNamespace>
    <!--
      No PackageReference by design. NBomber 6.x is commercially licensed (organisations
      need a paid subscription and an activation key), which does not fit a public MIT
      repository whose load-testing method is meant to be usable by anyone who clones it.
      Scheduling, timing and percentile statistics are written here against the BCL.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied to output so a run can start from it, and so the test project can assert
         that the shipped sample actually parses and validates. -->
    <Content Include="loadtest.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The only package reference here, and it is not an exception to the "no packages" rule:
         Bee.Db references no ADO.NET driver because that is the host's decision, and in Local
         mode this project IS the host. Every backend that runs has to reference one. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bee.Api.Client\Bee.Api.Client.csproj" />
    <ProjectReference Include="..\..\src\Bee.Db\Bee.Db.csproj" />
    <ProjectReference Include="..\..\src\Bee.Definition\Bee.Definition.csproj" />
    <ProjectReference Include="..\..\src\Bee.Hosting\Bee.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Bee.ObjectCaching\Bee.ObjectCaching.csproj" />
  </ItemGroup>

</Project>
