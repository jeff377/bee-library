			<IndexFields>
				<IndexField FieldName="sys_no" />
			</IndexFields>
		</DbTableIndex>
		<DbTableIndex Name="rx_{0}" Unique="true">
			<IndexFields>
				<IndexField FieldName="sys_rowid" />
			</IndexFields>
		</DbTableIndex>
		<DbTableIndex Name="ux_{0}" Unique="true">
			<IndexFields>
				<IndexField FieldName="sys_id" />
			</IndexFields>
		</DbTableIndex>
	</Indexes>
</TableSchema>
