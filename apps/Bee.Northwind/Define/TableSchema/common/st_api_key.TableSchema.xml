		<DbField FieldName="sys_name" Caption="應用程式名稱" DbType="String" Length="100" />
		<DbField FieldName="hashed_key" Caption="雜湊金鑰" DbType="String" Length="200" />
		<DbField FieldName="key_type" Caption="金鑰類型" DbType="Integer" DefaultValue="1" />
