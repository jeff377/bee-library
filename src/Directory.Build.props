<Project>
  <PropertyGroup>
    <!-- 版本資訊 -->
    <Version>4.18.0</Version>
    <AssemblyVersion>4.18.0.0</AssemblyVersion>
    <FileVersion>4.18.0.0</FileVersion>
<!---->
    <!-- 套件 Metadata -->
    <Company>Bee.NET</Company>
    <Authors>Bee.NET</Authors>
    <Product>Bee.NET</Product>
    <Copyright>© Bee.NET. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jeff377/bee-library</PackageProjectUrl>
    <PackageIcon>bee.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 打包 -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- 文件 -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>

    <!-- 語言特性 -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 健康檢查 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/jeff377/bee-library</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Opt-in per-project SARIF diagnostics, used to regenerate the PublicAPI baselines in bulk.
         Off unless BeeSarifDir is passed, so normal builds are unaffected. Procedure:
         docs/repo-ops/public-api-baseline.md -->
    <ErrorLog Condition="'$(BeeSarifDir)' != ''">$(BeeSarifDir)/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\bee.png" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.202" PrivateAssets="All"/>
    <!-- Public API surface tracking. RS0016/RS0017 turn "a published type or member was added,
         removed or changed" into a build failure unless the baseline below is updated in the same
         commit, so a breaking change can no longer reach a release without someone noticing.
         Adopted because the commit-subject `!` convention was previously the only gate and it
         missed real breaks twice. Baseline maintenance: docs/repo-ops/public-api-baseline.md. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
