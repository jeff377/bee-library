<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Implements core business logic and application-level workflows.</Description>
    <PackageTags>bee.net;business;application;backend;contracts;repository;json-rpc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bee.Business.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!--
    Framework convention analyzers applied to this project itself: BEE3001 checks that every public
    business object method declares access control, and this is where the business objects live.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bee.Analyzers\Bee.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bee.Api.Contracts\Bee.Api.Contracts.csproj" />
    <ProjectReference Include="..\Bee.Definition\Bee.Definition.csproj" />
    <ProjectReference Include="..\Bee.Expressions\Bee.Expressions.csproj" />
    <ProjectReference Include="..\Bee.Repository.Abstractions\Bee.Repository.Abstractions.csproj" />
  </ItemGroup>

</Project>
