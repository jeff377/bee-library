<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Encapsulates API support such as model definitions, encryption, and serialization.</Description>
    <PackageTags>bee.net;api;core;service;dynamicapi</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Declared explicitly even though Bee.Definition already brings it in transitively.
         MessagePack is this project's wire ABI, not an incidental dependency: 70 files here
         use it and the default payload format is MessagePack. Leaving the version pinned
         solely by Bee.Definition means a change there would alter this package's on-the-wire
         behaviour with no local signal, and consumers of the published NuGet package could
         not see the contract at all. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
  </ItemGroup>

  <!--
    Framework convention analyzers applied to this project itself. BEE4001 (missing
    CollectionBaseFormatter registration) only activates in the compilation that owns the registration
    list, which is this one — without this reference that rule would never run anywhere.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bee.Analyzers\Bee.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bee.Api.Contracts\Bee.Api.Contracts.csproj" />
    <ProjectReference Include="..\Bee.Definition\Bee.Definition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bee.Api.Core.UnitTests" />
    <!-- The error contract has two halves: JsonRpcExecutor.MapException maps an exception to a
         code, and ApiConnector.FinalizeResponse maps that code back to an exception. Only a test
         that sees both can assert they agree, and the client test project is the one that already
         references both assemblies. -->
    <InternalsVisibleTo Include="Bee.Api.Client.UnitTests" />
  </ItemGroup>

</Project>
