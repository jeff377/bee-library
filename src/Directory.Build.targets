<Project>

  <!--
    Dependency boundary for the two lowest-level assemblies (ADR-038).

    Bee.Base is a dependency of every project in the framework and Bee.Definition has six direct
    dependents, so anything added here is inherited by every consumer of the framework — including
    consumers that only want to read definitions. This target locks both projects to an explicit
    allowlist: adding a reference fails the build rather than silently widening the public
    dependency surface. Widening it is allowed, but it has to be a decision someone made on
    purpose — edit the allowlist below and record the reasoning in ADR-038.

    Only consumer-facing references are checked, because those are the ones that reach the nuspec:
    a PackageReference marked PrivateAssets="all" (SourceLink, analyzers) is build-time only, and a
    ProjectReference with ReferenceOutputAssembly="false" (the Bee.Analyzers build ordering
    reference) contributes no assembly.

    The same boundary is asserted from the other end by
    tests/Bee.Definition.UnitTests/DefinitionDependencyGateTests.cs, which walks the full
    transitive closure. The two are complements, not duplicates: this target catches the direct
    edge at the moment it is written, the test catches a package that arrives indirectly through a
    project reference — which is exactly how DynamicExpresso.Core got in.
  -->

  <PropertyGroup>
    <BeeEnforceDependencyBoundary Condition="'$(MSBuildProjectName)' == 'Bee.Base' Or '$(MSBuildProjectName)' == 'Bee.Definition'">true</BeeEnforceDependencyBoundary>
  </PropertyGroup>

  <!-- Bee.Base: no consumer-facing dependency of any kind. The allowlist is deliberately empty. -->

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Bee.Definition'">
    <!-- Microsoft first-party, abstraction-only, versioned with .NET itself: it makes no technology
         choice on the consumer's behalf. Used by Language/BeeStringLocalizer.cs. -->
    <BeeAllowedDependency Include="Microsoft.Extensions.Localization.Abstractions" />
    <BeeAllowedDependency Include="Bee.Base" />
  </ItemGroup>

  <!--
    Version consistency (BEE9002).

    `Version` stamps the NuGet package; `AssemblyVersion` and `FileVersion` stamp the assembly
    identity inside it. They are three separate properties and nothing keeps them in step, so a
    release that edits only `Version` ships packages whose assemblies still claim the previous
    version. A published package cannot be recalled, only delisted.

    This has now happened twice. 4.17.0 shipped assemblies stamped 4.16.0.0; that was corrected by
    hand in 4.18.0, and then 4.19.0 shipped assemblies stamped 4.18.0.0. Correcting the number
    fixed each release without fixing the mechanism, and the second occurrence was found the same
    way as the first — by a person reading the file. This target is the mechanism: get it wrong and
    the build fails where the edit was made, not two releases later.

    A prerelease suffix would break the comparison, and `Version` has never carried one. If that
    changes, teach this target the suffix rather than exempting the project from it.
  -->
  <Target Name="BeeVerifyVersionConsistency" BeforeTargets="Build">
    <Error Condition="'$(AssemblyVersion)' != '$(Version).0'"
           Code="BEE9002"
           Text="AssemblyVersion '$(AssemblyVersion)' does not match Version '$(Version)' (expected '$(Version).0'). All three of Version, AssemblyVersion and FileVersion are set in src/Directory.Build.props and must be bumped together; a package whose assembly identity lags its package version cannot be told apart from the previous release, and cannot be recalled once published." />
    <Error Condition="'$(FileVersion)' != '$(Version).0'"
           Code="BEE9002"
           Text="FileVersion '$(FileVersion)' does not match Version '$(Version)' (expected '$(Version).0'). See the AssemblyVersion message above — the three properties in src/Directory.Build.props are bumped together." />
  </Target>

  <Target Name="BeeVerifyDependencyBoundary"
          BeforeTargets="Build"
          Condition="'$(BeeEnforceDependencyBoundary)' == 'true'">
    <ItemGroup>
      <_BeeConsumerFacingDependency Include="@(PackageReference)"
                                    Exclude="@(PackageReference->WithMetadataValue('PrivateAssets', 'all'))" />
      <_BeeConsumerFacingDependency Include="@(ProjectReference->'%(Filename)')"
                                    Exclude="@(ProjectReference->WithMetadataValue('ReferenceOutputAssembly', 'false')->'%(Filename)')" />
      <_BeeBoundaryViolation Include="@(_BeeConsumerFacingDependency)"
                             Exclude="@(BeeAllowedDependency)" />
    </ItemGroup>

    <Error Condition="'@(_BeeBoundaryViolation)' != ''"
           Code="BEE9001"
           Text="$(MSBuildProjectName) is one of the two lowest-level assemblies and is locked to an explicit dependency allowlist (ADR-038). Unexpected consumer-facing reference(s): @(_BeeBoundaryViolation, ', '). Anything added here is inherited by every consumer of the framework. Prefer keeping the abstraction here and the implementation in a separate assembly that only a composition root references. If the dependency really belongs here, add it to BeeAllowedDependency in src/Directory.Build.targets, add it to the whitelist in tests/Bee.Definition.UnitTests/DefinitionDependencyGateTests.cs, and record why in docs/adr/adr-038-definition-dependency-boundary.md." />
  </Target>

</Project>
