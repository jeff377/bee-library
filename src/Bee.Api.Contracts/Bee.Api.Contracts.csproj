<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Defines the interface contracts for the API layer, serving as the boundary between the API layer and the business logic layer.</Description>
    <PackageTags>bee.net;api;contracts;interface;dto;shared</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit rather than transitive via Bee.Definition: the concrete DTOs here carry
         MessagePack attributes, so it is part of this package's contract. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
  </ItemGroup>

  <!--
    Framework convention analyzers applied to this project itself: BEE4002-4006 check the shape of
    MessagePack-serialized types, and the wire DTOs here are exactly that. Without this reference the
    rules stay silent for this assembly (BEE4001 is the only one that reaches across assemblies).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bee.Analyzers\Bee.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bee.Definition\Bee.Definition.csproj" />
  </ItemGroup>

</Project>
