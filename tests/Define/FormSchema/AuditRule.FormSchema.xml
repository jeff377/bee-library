<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-form audit rules. Maintained through the framework's own CRUD path, so changing the audit
  policy is itself an ordinary form save — and is always recorded, whatever this table says.

  PermissionModelId is declared deliberately, unlike the other framework-shipped forms: audit
  policy is a privileged operation (SAP gates SE13 behind Basis rights, Odoo puts auditlog.rule
  behind Technical Features). Enforcement is fail-closed, so after copying this into a deployment
  the `AuditRule` model must be granted to a role before anyone can open the form. See
  PermissionModels.xml for the matching registry entry.

  The two mode fields take their dropdown options from the `AuditRuleMode` language enum rather
  than static ListItems, so the options follow the caller's language like every other label.

  ControlType is set explicitly on all three non-text fields. `Auto` does not infer a dropdown from
  the presence of options — it falls back to TextEdit — so an option source without a ControlType
  loads the options and then has nowhere to show them.
-->
<FormSchema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" ProgId="AuditRule" DisplayName="稽核規則" CategoryId="company" PermissionModelId="AuditRule" ListFields="sys_id,sys_name,change_mode,access_mode,is_sensitive">
  <Tables>
    <FormTable TableName="AuditRule" DbTableName="st_audit_rule" DisplayName="稽核規則">
      <Fields>
        <FormField FieldName="sys_no" Caption="流水號" DbType="AutoIncrement" Visible="false" />
        <FormField FieldName="sys_rowid" Caption="唯一識別" DbType="Guid" Visible="false" />
        <FormField FieldName="sys_id" Caption="表單代碼" DbType="String" Required="true" />
        <FormField FieldName="sys_name" Caption="表單名稱" DbType="String" />
        <FormField FieldName="change_mode" Caption="異動記錄" DbType="Integer" ControlType="DropDownEdit" LangEnumName="AuditRuleMode" />
        <FormField FieldName="access_mode" Caption="檢視記錄" DbType="Integer" ControlType="DropDownEdit" LangEnumName="AuditRuleMode" />
        <FormField FieldName="is_sensitive" Caption="敏感資料" DbType="Boolean" ControlType="CheckEdit" />
        <FormField FieldName="remark" Caption="備註" DbType="String" />
        <FormField FieldName="sys_insert_time" Caption="寫入時間" DbType="DateTime" Visible="false" />
      </Fields>
    </FormTable>
  </Tables>
</FormSchema>
