<Project>

  <!--
    Version consistency (BEE9002).

    `Version` stamps the NuGet package; `AssemblyVersion` and `FileVersion` stamp the assembly
    identity inside it. A release that edits only `Version` ships packages whose assemblies still
    claim the previous version, and a published package cannot be recalled, only delisted.

    This has happened twice in the framework packages. 4.17.0 shipped assemblies stamped 4.16.0.0;
    that was corrected by hand in 4.18.0, and then 4.19.0 shipped assemblies stamped 4.18.0.0.
    Correcting the number fixed each release without fixing the mechanism, and both occurrences were
    found the same way — by a person reading the file.

    Imported by src/Directory.Build.targets and tools/Directory.Build.targets so both trees are
    covered. It is the companion to Version.props: that file removes the chance of two projects
    disagreeing, this one removes the chance of one project disagreeing with itself (which is what a
    command-line `/p:Version=` override during release can produce).

    A prerelease suffix would break the comparison, and `Version` has never carried one. If that
    changes, teach this target the suffix rather than exempting a project from it.
  -->
  <Target Name="BeeVerifyVersionConsistency" BeforeTargets="Build">
    <Error Condition="'$(AssemblyVersion)' != '$(Version).0'"
           Code="BEE9002"
           Text="AssemblyVersion '$(AssemblyVersion)' does not match Version '$(Version)' (expected '$(Version).0'). All three of Version, AssemblyVersion and FileVersion come from Version.props at the repository root and are bumped together; a package whose assembly identity lags its package version cannot be told apart from the previous release, and cannot be recalled once published." />
    <Error Condition="'$(FileVersion)' != '$(Version).0'"
           Code="BEE9002"
           Text="FileVersion '$(FileVersion)' does not match Version '$(Version)' (expected '$(Version).0'). See the AssemblyVersion message above — the three properties in Version.props are bumped together." />
  </Target>

</Project>
